    {
      "id": "CNN37BPk_fralMoPry8ri",
      "type": "text",
      "x": 497,
      "y": 20,
      "width": 675.67822265625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
