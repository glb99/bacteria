dist/

# Local database created by create_tables()
*.db

# Editor state. `.vscode/settings.json` here only sets the test runner,
# which `just test` already does correctly; committing it would make one
# person's IDE layout everyone else's problem.
.vscode/

# The console's build output, produced by `just console-build` from `frontend/`.
# Ignored because it is an artifact: committing it would make every frontend
# change show up twice in review, once as source and once as minified output
# nobody can read. It is installed as package data, so CI and the deploy have to
# build it -- see `.github/workflows/deploy.yml`, where building it *after*
# `fastapi deploy` would ship an application with no console and say nothing.
#
# **This line is deleted by the deploy workflow, on purpose.** `fastapi deploy`
# archives its working directory with `rignore`, which honours this file -- so
# ignoring the artifact here also excluded it from the upload, and the first
# deploy after the console existed reported success while `/` answered 404.
# The workflow removes this exact line before deploying and fails if the path is
# still ignored afterwards. Changing the pattern below means changing that step.
backend/app/src/bacteria/app/console/

# The OpenAPI document, dumped from the application to generate the client from.
# An intermediate: `frontend/src/api.gen.ts` is the committed artifact, and the
# frontend CI job regenerates it and fails when it differs.
frontend/openapi.json

node_modules/

# Playwright browser binaries and its run output.
frontend/test-results/
frontend/playwright-report/
