    {
      "id": "QEKuJ85P71s7DSs601axc",
      "type": "text",
      "x": 512,
      "y": 309.86111111111103,
      "width": 1689.77880859375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 413011771,
      "version": 645,
      "versionNonce": 769501627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784195896528,
      "link": null,
      "locked": false,
      "text": "Goal: create a complete agentic architecture for designing systems:\n- knoledge creation and distilation\n- knowledge storing\n- stored knowledge structure: global folders, per-project folders... (knowledge templates)\n- other capabilities: vide, image... processing, autoresearch..., other providers integration...\n- some protocols should be part of the system architecture (memory management, anti-slop, processing pipelines...), others should be done autonomously by the agent + skills\n- all integrated in our own UI, CLI, API...\n- ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Goal: create a complete agentic architecture for designing systems:\n- knoledge creation and distilation\n- knowledge storing\n- stored knowledge structure: global folders, per-project folders... (knowledge templates)\n- other capabilities: vide, image... processing, autoresearch..., other providers integration...\n- some protocols should be part of the system architecture (memory management, anti-slop, processing pipelines...), others should be done autonomously by the agent + skills\n- all integrated in our own UI, CLI, API...\n- ",
      "autoResize": true,
      "lineHeight": 1.25
    },
