# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Two classes of variable live here and they are read by different things, which
# is why only one of them has a prefix.
#
#   BACTERIA_*  are this application's settings, read by `core.settings.Settings`
#               and nothing else. A BACTERIA_ variable matching no field is a
#               startup failure, on purpose -- BACTERIA_DATABSE_URL would
#               otherwise leave the default in place and the service would come
#               up happily against the wrong database.
#
#   everything  are provider SDK credentials, read by the SDKs themselves from
#   else        the real environment under these exact unprefixed names. Nothing
#               can rename them. `core.settings.load_env_file` is what puts them
#               there, called from each entrypoint.
#
# See backend/app/src/bacteria/app/core/settings.py for both halves.


# --- Application settings -----------------------------------------------------

# Must name an async driver. `postgresql+psycopg://` is psycopg 3's dialect and
# serves both modes: create_engine gives sync, create_async_engine gives async.
# Do not strip `+psycopg` to "make it synchronous" -- that routes the URL to
# psycopg2, which is not installed.
BACTERIA_DATABASE_URL=postgresql+psycopg://bacteria:bacteria@localhost:5432/bacteria

BACTERIA_LOG_LEVEL=INFO

# Run the job worker inside the API process rather than as `bacteria-worker`.
# Leave this off locally: `just worker` and `just stack` both run a real one, and
# two workers on one queue is not an error either can detect. It exists for
# single-process platforms, where the alternative is no worker at all and
# `:defer` answering 202 for work nothing performs. See docs/adr/0001.
# BACTERIA_RUN_WORKER_IN_API=false
# BACTERIA_WORKER_CONCURRENCY=4

# Which provider backs the agent: anthropic or gemini.
BACTERIA_MODEL_PROVIDER=anthropic

# Read the new transcript items after each turn and *propose* memories from
# them. Off by default because it is a second model call per turn -- roughly
# doubling per-turn spend -- and because nothing yet surfaces how many proposals
# are waiting, so the output accumulates unread until someone looks. Nothing it
# writes can reach a model without a human activating it, so leaving it on costs
# money and review backlog rather than behaviour. See docs/adr/0002.
# BACTERIA_MEMORY_EXTRACTION_ENABLED=false

# Which model does the extracting. The provider and its credential are shared
# with the agent; only the model differs, so the value here must be one the
# provider above actually serves -- a Claude name under `gemini` is a runtime
# failure, not a fallback.
#
# Unset uses the client's own default. Worth knowing that the two providers
# differ in whether that is worth overriding: the Anthropic client defaults to
# a conversational model, which is more than this job needs when it fills a
# small JSON schema from a bounded transcript slice, while the Gemini client
# already defaults to a fast one.
# BACTERIA_MEMORY_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# The most proposals one extraction run may write. Bounds the review queue,
# which the agent's ADR 0017 named as unbounded and left that way.
# BACTERIA_MEMORY_EXTRACTION_MAX_PROPOSALS=5


# --- Provider credentials -----------------------------------------------------

# Needed by whichever provider is selected above. Unprefixed because the SDKs
# read these names and no others.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Read by the agent's own composition root when running `just agent` standalone.
# Separate from BACTERIA_MODEL_PROVIDER deliberately: two packages agreeing on
# one variable is a coupling no import graph would show you.
MODEL_PROVIDER=anthropic
