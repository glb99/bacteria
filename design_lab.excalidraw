      "seed": 2109538469,
      "version": 150,
      "versionNonce": 1875196619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789993262331,
      "link": null,
      "locked": false,
      "text": "- A transcriptions system: take the transcription, analyse it, there\nare some metrics we must analyse, only a call is needed, if there is\nsomething to calculate, THERE IS, no decission of how to do it is\nneeded, no decission on if it should be done is needed, no agentic\nruntime is needed.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- A transcriptions system: take the transcription, analyse it, there are some metrics we must analyse, only a call is needed, if there is something to calculate, THERE IS, no decission of how to do it is needed, no decission on if it should be done is needed, no agentic runtime is needed.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "7q1LlBjHmhGSpq9wKEJ_i",
      "type": "text",
      "x": 493,
      "y": 164,
      "width": 683.11865234375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
